# Copy to .env (or export directly) and fill in for your environment.
# These configure the headless Node-RED engine (see node-red/settings.js).

QLAB_OSC_HOST=127.0.0.1
QLAB_OSC_PORT=53000
# Local UDP port this app listens on for QLab's replies/updates.
LOCAL_OSC_PORT=53001

DB_PATH=./data/schedule.db

# Port for Node-RED's internal, loopback-only HTTP API that the FastAPI webapp calls.
# No dashboard UI is served here anymore - see the Frontend Pivot in docs/claude-plan.md.
# (DASHBOARD_PORT is still accepted as a fallback name for backward compatibility.)
NODE_RED_API_PORT=1880

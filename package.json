{
  "name": "herald",
  "version": "0.1.0",
  "private": true,
  "description": "QLab scheduled audio messaging system: Node-RED + cron-plus + SQLite + OSC scheduling layer for QLab.",
  "main": "lib/index.js",
  "scripts": {
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"lib/**/*.js\" \"node-red/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" \"webapp/static/js/**/*.js\" \"*.js\"",
    "format:check": "prettier --check \"lib/**/*.js\" \"node-red/**/*.js\" \"scripts/**/*.js\" \"test/**/*.js\" \"webapp/static/js/**/*.js\" \"*.js\"",
    "spike:qlab": "node scripts/phase0-qlab-spike.js",
    "node-red": "node-red --userDir ./node-red",
    "deploy:install": "deploy/launchd/install.sh",
    "deploy:uninstall": "deploy/launchd/uninstall.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "webapp/**/*.py": [
      "webapp/.venv/bin/ruff check --fix",
      "webapp/.venv/bin/ruff format"
    ]
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "node-red": "5.0.1",
    "node-red-contrib-cron-plus": "2.2.4",
    "osc": "2.4.5",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2"
  }
}

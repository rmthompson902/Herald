  {
    "id": "fn_next_occurrences",
    "type": "function",
    "z": "tab_api",
    "name": "compute next occurrence per schedule",
    "func": "const core = global.get('core');\nconst schedules = core.db.schedules.listEnabled(core.db.connection);\nconst from = new Date();\n\nconst nextOccurrences = {};\nfor (const s of schedules) {\n    const occurrences = core.scheduling.occurrenceCalculator.nextOccurrences(s, from, 1);\n    nextOccurrences[s.id] = occurrences[0] ? occurrences[0].toISOString() : null;\n}\n\nmsg.statusCode = 200;\nmsg.payload = { status: 'success', nextOccurrences };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 400,
    "wires": [
      [
        "httpresp_next_occurrences"
      ]
    ]
  },

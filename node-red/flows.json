    "name": "listCues (live OSC)",
    "func": "const core = global.get('core');\n\nreturn (async () => {\n    try {\n        const cues = await core.osc.protocol.listCues();\n        msg.statusCode = 200;\n        msg.payload = { status: 'success', cues };\n    } catch (err) {\n        msg.statusCode = 503;\n        msg.payload = { status: 'error', message: err.message };\n    }\n    return msg;\n})();",

  {
    "id": "fn_zone_patches",
    "type": "function",
    "z": "tab_api",
    "name": "getAudioPatches (live OSC)",
    "func": "const core = global.get('core');\n\nreturn (async () => {\n    try {\n        const patches = await core.osc.protocol.getAudioPatches();\n        // 1-based index, matching /cue/{n}/patch's own indexing convention\n        const withIds = patches.map((patch, i) => ({ patchId: String(i + 1), name: patch.name }));\n        msg.statusCode = 200;\n        msg.payload = { status: 'success', patches: withIds };\n    } catch (err) {\n        msg.statusCode = 503;\n        msg.payload = { status: 'error', message: err.message };\n    }\n    return msg;\n})();",
